{
  "realm": "canchago",
  "enabled": true,
  "displayName": "Canchago",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "passwordPolicy": "length(8) and notUsername",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "canchago-api",
      "name": "Canchago API",
      "description": "Cliente OIDC confidencial del backend Canchago (Authorization Code + PKCE)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "canchago-dev-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/api/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "defaultClientScopes": [
        "openid",
        "email",
        "profile",
        "roles",
        "web-origins",
        "acr"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    },
    {
      "clientId": "canchago-mobile",
      "name": "Canchago Mobile",
      "description": "Cliente OIDC publico de la app movil Canchago (Ionic/Capacitor), Resource Owner Password Credentials (formulario nativo de usuario/contrasena) - ver spec 014",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "ec.canchago.app://auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "openid",
        "email",
        "profile",
        "roles",
        "web-origins",
        "acr"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    },
    {
      "clientId": "canchago-registration-service",
      "name": "Canchago Registration Service",
      "description": "Cliente de servicio (client_credentials) usado solo por el backend para crear usuarios en Keycloak durante el registro publico - ver spec 016. Sin flujos de usuario: no es para login, solo para la API de administracion de Keycloak.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "canchago-registration-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "openid",
        "web-origins"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "service-account-canchago-registration-service",
      "enabled": true,
      "serviceAccountClientId": "canchago-registration-service",
      "clientRoles": {
        "realm-management": [
          "manage-users"
        ]
      }
    },
